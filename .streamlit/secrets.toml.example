# Скопируйте этот файл в .streamlit/secrets.toml (не загружайте его на GitHub!)
# или вставьте нужные строки в Streamlit Cloud → App settings → Secrets.
# Оба ключа необязательны: без них работает бесплатный режим «скопировать промпт в ChatGPT».
OPENAI_API_KEY = "sk-..."
ANTHROPIC_API_KEY = "sk-ant-api03-..."
